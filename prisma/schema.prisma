// Miraflores Tax Workpaper — data model
// Three layers: A (raw, immutable) · B (normalized packet, read-only) · C (workpaper, ours)
// See docs/DATA_MODEL.md for the ER diagram and rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Layer A — Raw (immutable). Never mutated. Re-importing the same sha is a no-op.
// ---------------------------------------------------------------------------
model PacketImport {
  id         String   @id @default(cuid())
  sha256     String   @unique
  raw        Json
  importedAt DateTime @default(now())
  isActive   Boolean  @default(false)
}

// ---------------------------------------------------------------------------
// Layer B — Normalized packet (read-only after import)
// ---------------------------------------------------------------------------
model Document {
  id                String   @id // "D09"
  title             String
  documentType      String
  issuer            String?
  belongsTo         String?
  taxYear           Int?
  receivedAt        DateTime?
  uploadedBy        String?
  fileName          String?
  pageCount         Int
  markedCorrected   Boolean  @default(false)
  extractionStatus  String // extracted | partial | not_extracted
  extractionReason  String?

  pages            Page[]
  extractedValues  ExtractedValue[]
}

model Page {
  documentId     String
  pageNo         Int
  printedContent String
  renderKind     String  @default("simulated") // simulated | pdf
  assetUri       String?

  document Document @relation(fields: [documentId], references: [id])

  @@id([documentId, pageNo])
}

model ExtractedValue {
  id          String  @id // "ev-0035"
  documentId  String
  pageNo      Int?
  field       String
  label       String?
  valueJson   Json
  valueType   String
  textAsRead  String
  position    Json?
  confidence  Float

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId, pageNo])
  @@index([valueType])
}

model ClientItem {
  id      String   @id // qa-NN | msg-NN | call-NN
  kind    String // questionnaire | message | call_note
  payload Json
  at      DateTime?
}

model ReturnVersion {
  id                  String   @id // v1 | v2 | v3
  computedAt          DateTime
  trigger             String?
  summary             Json
  taxEffectRates      Json
  documentsUsed       String[]
  documentsSuperseded String[]

  lines       ReturnLine[]
  diagnostics Diagnostic[]
}

model ReturnLine {
  versionId    String
  key          String
  jurisdiction String
  form         String?
  line         String?
  label        String?
  valueJson    Json
  rule         String?
  note         String?

  version ReturnVersion @relation(fields: [versionId], references: [id])

  @@id([versionId, key])
  @@index([versionId])
}

model LineInput {
  id        String @id @default(cuid())
  versionId String
  lineKey   String
  inputKey  String

  @@index([versionId, lineKey])
}

model LineSource {
  id        String  @id @default(cuid())
  versionId String
  lineKey   String
  refRaw    String
  refKind   String
  targetId  String?
  resolved  Boolean @default(false)

  @@index([versionId, lineKey])
  @@index([refRaw])
}

model Diagnostic {
  id        String @id @default(cuid())
  versionId String
  code      String
  severity  String
  message   String
  refs      String[]

  version ReturnVersion @relation(fields: [versionId], references: [id])

  @@index([versionId])
}

model Staff {
  id                    String  @id // st-01
  role                  String
  credential            String?
  sensitiveDataClearance Boolean @default(false)
}

model ClientUser {
  id      String @id
  payload Json
}

// prior_years, tax_agency_records, timeline, engine_reference kept as blobs,
// reachable by JSON pointer through the resolver.
model PacketBlob {
  key     String @id // prior_years | tax_agency_records | timeline | engine_reference | household | firm | fx_rates
  payload Json
}

// ---------------------------------------------------------------------------
// Layer C — Workpaper (ours). Grows in later blocks. Confidence is never a status.
// ---------------------------------------------------------------------------
model Verification {
  id               String   @id @default(cuid())
  extractedValueId String
  status           String // agreed_to_source | mismatch_with_source | not_printed | needs_human | human_verified | human_corrected
  method           String // auto | human
  verificationType String?
  sourceText       String?
  correctedValue   String?
  actorId          String?
  at               DateTime @default(now())
  note             String?
  version          Int      @default(0)

  @@index([extractedValueId])
}

model DocumentLink {
  id        String @id @default(cuid())
  fromDocId String
  toDocId   String
  kind      String // duplicate_of | supersedes | same_issuer | related_prior_year
  basis     Json?
  method    String // auto | human
  actorId   String?

  @@index([fromDocId])
  @@index([toDocId])
}

model PageLink {
  id              String @id @default(cuid())
  docId           String
  pageNo          Int
  duplicateOfPage Int
  basis           Json?

  @@index([docId])
}

model Disposition {
  documentId String @id
  status     String // used | duplicate_not_counted | superseded | partial_extraction | structured_elsewhere | received_after_return | unaccounted
  reason     String?
  refs       String[]
}

model CheckRun {
  id          String   @id @default(cuid())
  versionId   String
  at          DateTime @default(now())
  codeVersion String?

  results CheckResult[]
}

model CheckResult {
  id           String  @id // stable finding id = sha256(checkId + sorted refs)
  runId        String
  checkId      String
  status       String // pass | fail | warn | info
  title        String
  expected     Json?
  actual       Json?
  delta        BigInt?
  taxEffectFed BigInt?
  taxEffectCa  BigInt?
  rateCategory String?
  refs         String[]
  explanation  String?
  suggestedFix Json?

  run CheckRun @relation(fields: [runId], references: [id])

  @@index([runId])
  @@index([checkId])
}

model Attachment {
  id         String   @id @default(cuid())
  kind       String // file | message | note
  storageUri String?
  sha256     String?
  text       String?
  uploadedBy String?
  at         DateTime @default(now())

  links AttachmentLink[]
}

model AttachmentLink {
  id           String @id @default(cuid())
  attachmentId String
  targetKind   String // document | extracted_value | line | check_result
  targetId     String

  attachment Attachment @relation(fields: [attachmentId], references: [id])

  @@index([targetKind, targetId])
}

// ---------------------------------------------------------------------------
// Block 2 — Change + Judgment
// ---------------------------------------------------------------------------
model Issue {
  id          String   @id // stable fingerprint
  title       String
  area        String
  kind        String
  status      String   @default("open") // open | proposed | in_review | resolved | dismissed
  findingIds  String[]
  refs        String[]
  ownerId     String?
  materiality BigInt   @default(0)
  dismissReason String?
  version     Int      @default(0)
  createdAt   DateTime @default(now())
}

model Adjustment {
  id            String   @id @default(cuid())
  issueId       String?
  baseVersionId String
  targets       Json // AdjTarget[]
  primaryLineKey String?
  rateCategory  String?
  caSourceFlag  Boolean  @default(false)
  baseDeltaCents BigInt  @default(0)
  taxEffectFed  BigInt   @default(0)
  taxEffectCa   BigInt   @default(0)
  paymentEffectFed BigInt @default(0)
  paymentEffectCa  BigInt @default(0)
  method        String // rate_estimate | what_if_exact
  reason        String
  evidenceIds   String[]
  preparedBy    String?
  reviewedBy    String?
  approvedBy    String?
  batchId       String?
  supersedesId  String?
  version       Int      @default(0)
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  approvedAt    DateTime?

  @@index([issueId])
  @@index([status])
}

model FactCorrection {
  id               String   @id @default(cuid())
  extractedValueId String
  original         Json // read-only copy
  corrected        Json
  verificationType String?
  reason           String
  evidenceIds      String[]
  actorId          String?
  at               DateTime @default(now())

  @@index([extractedValueId])
}

model Batch {
  id             String   @id @default(cuid())
  actorId        String?
  action         String
  itemRefs       String[]
  previewHash    String?
  appliedAt      DateTime @default(now())
  undoneByBatchId String?
}

model Snapshot {
  id          String   @id @default(cuid())
  label       String
  kind        String // engine_version | review_point | client_signed | filed | manual
  eventSeq    Int
  asOf        DateTime
  contentHash String
  lines       Json
  createdAt   DateTime @default(now())
}

model Scenario {
  id             String   @id @default(cuid())
  ownerId        String?
  baseSnapshotId String?
  changes        Json
  result         Json
  promotedToIds  String[]
  createdAt      DateTime @default(now())
}

model UserCursor {
  userId      String @id
  lastSeenSeq Int    @default(0)
}

model Decision {
  id              String   @id @default(cuid())
  issueId         String?
  question        String
  facts           String?
  evidenceIds     String[]
  type            String
  options         Json
  selectedOptionId String?
  authority       String?
  positionStrength String?
  preparedBy      String?
  reviewedBy      String?
  approvedBy      String?
  status          String   @default("draft")
  revision        Int      @default(0)
  supersedesId    String?
  dependencyHash  String?
  watchedLineKeys String[]
  weakEvidenceAccepted Boolean @default(false)
  missingEvidenceResolved Boolean @default(false)
  createdAt       DateTime @default(now())

  @@index([issueId])
}

model DueDiligence {
  id               String   @id @default(cuid())
  credit           String
  personId         String?
  items            Json
  status           String   @default("open")
  blockedByIssueIds String[]
}

model ExpectedDocument {
  id                String  @id @default(cuid())
  source            String
  description       String
  matchedDocumentId String?
  status            String  @default("expected")
}

model AreaReview {
  area              String   @id
  computedReadiness String
  attestedBy        String?
  attestedAt        DateTime?
  reason            String?
}

model OutsideFiling {
  id              String   @id @default(cuid())
  filing          String
  whoFiles        String?
  inEngagement    Boolean  @default(false)
  status          String   @default("open")
  evidence        String[]
  clientNotifiedAt DateTime?
}

// ---------------------------------------------------------------------------
// Block 3 — People
// ---------------------------------------------------------------------------
model Question {
  id          String   @id @default(cuid())
  fromId      String
  toId        String
  targetKind  String
  targetId    String
  text        String
  dueAt       DateTime?
  status      String   @default("open")
  blocksFiling Boolean @default(false)
  answerAttachmentId String?
  createdAt   DateTime @default(now())

  @@index([targetKind, targetId])
}

model ReviewNote {
  id         String   @id @default(cuid())
  authorId   String
  assigneeId String?
  targetKind String
  targetId   String
  severity   String
  status     String   @default("open")
  thread     Json     @default("[]")
  createdAt  DateTime @default(now())

  @@index([targetKind, targetId])
  @@index([status])
}

model SignOff {
  id          String   @id @default(cuid())
  level       String
  scope       String
  coveredRefs String[]
  coveredHash String
  signedBy    String
  signedAt    DateTime @default(now())
  status      String   @default("valid")
  reopenReason String?
  diff        String?

  @@index([scope])
  @@index([status])
}

model Assignment {
  id        String   @id @default(cuid())
  scopeKind String
  scopeId   String
  staffId   String
  role      String
  dueAt     DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([staffId])
}

model Notification {
  id       String   @id @default(cuid())
  userId   String
  type     String
  entityId String
  message  String
  readAt   DateTime?
  at       DateTime @default(now())

  @@index([userId])
}

model TimeEntry {
  id      String   @id @default(cuid())
  staffId String
  area    String
  minutes Int
  note    String?
  at      DateTime @default(now())

  @@index([area])
}

model ViewLog {
  id      String   @id @default(cuid())
  actorId String
  field   String
  entityId String
  reason  String?
  at      DateTime @default(now())

  @@index([actorId])
}

model SoftLock {
  id         String   @id @default(cuid())
  entityKind String
  entityId   String
  holderId   String
  expiresAt  DateTime

  @@unique([entityKind, entityId])
}

// Append-only. Every workpaper write emits one. Hash-chained for tamper-evidence.
model Event {
  seq        Int      @id @default(autoincrement())
  id         String   @unique @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  type       String
  entityKind String
  entityId   String
  payload    Json
  prevHash   String?
  hash       String

  @@index([entityKind, entityId])
}
