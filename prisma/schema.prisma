// Miraflores Tax Workpaper — data model
// Three layers: A (raw, immutable) · B (normalized packet, read-only) · C (workpaper, ours)
// See docs/DATA_MODEL.md for the ER diagram and rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Layer A — Raw (immutable). Never mutated. Re-importing the same sha is a no-op.
// ---------------------------------------------------------------------------
model PacketImport {
  id         String   @id @default(cuid())
  sha256     String   @unique
  raw        Json
  importedAt DateTime @default(now())
  isActive   Boolean  @default(false)
}

// ---------------------------------------------------------------------------
// Layer B — Normalized packet (read-only after import)
// ---------------------------------------------------------------------------
model Document {
  id                String   @id // "D09"
  title             String
  documentType      String
  issuer            String?
  belongsTo         String?
  taxYear           Int?
  receivedAt        DateTime?
  uploadedBy        String?
  fileName          String?
  pageCount         Int
  markedCorrected   Boolean  @default(false)
  extractionStatus  String // extracted | partial | not_extracted
  extractionReason  String?

  pages            Page[]
  extractedValues  ExtractedValue[]
}

model Page {
  documentId     String
  pageNo         Int
  printedContent String
  renderKind     String  @default("simulated") // simulated | pdf
  assetUri       String?

  document Document @relation(fields: [documentId], references: [id])

  @@id([documentId, pageNo])
}

model ExtractedValue {
  id          String  @id // "ev-0035"
  documentId  String
  pageNo      Int?
  field       String
  label       String?
  valueJson   Json
  valueType   String
  textAsRead  String
  position    Json?
  confidence  Float

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId, pageNo])
  @@index([valueType])
}

model ClientItem {
  id      String   @id // qa-NN | msg-NN | call-NN
  kind    String // questionnaire | message | call_note
  payload Json
  at      DateTime?
}

model ReturnVersion {
  id                  String   @id // v1 | v2 | v3
  computedAt          DateTime
  trigger             String?
  summary             Json
  taxEffectRates      Json
  documentsUsed       String[]
  documentsSuperseded String[]

  lines       ReturnLine[]
  diagnostics Diagnostic[]
}

model ReturnLine {
  versionId    String
  key          String
  jurisdiction String
  form         String?
  line         String?
  label        String?
  valueJson    Json
  rule         String?
  note         String?

  version ReturnVersion @relation(fields: [versionId], references: [id])

  @@id([versionId, key])
  @@index([versionId])
}

model LineInput {
  id        String @id @default(cuid())
  versionId String
  lineKey   String
  inputKey  String

  @@index([versionId, lineKey])
}

model LineSource {
  id        String  @id @default(cuid())
  versionId String
  lineKey   String
  refRaw    String
  refKind   String
  targetId  String?
  resolved  Boolean @default(false)

  @@index([versionId, lineKey])
  @@index([refRaw])
}

model Diagnostic {
  id        String @id @default(cuid())
  versionId String
  code      String
  severity  String
  message   String
  refs      String[]

  version ReturnVersion @relation(fields: [versionId], references: [id])

  @@index([versionId])
}

model Staff {
  id                    String  @id // st-01
  role                  String
  credential            String?
  sensitiveDataClearance Boolean @default(false)
}

model ClientUser {
  id      String @id
  payload Json
}

// prior_years, tax_agency_records, timeline, engine_reference kept as blobs,
// reachable by JSON pointer through the resolver.
model PacketBlob {
  key     String @id // prior_years | tax_agency_records | timeline | engine_reference | household | firm | fx_rates
  payload Json
}

// ---------------------------------------------------------------------------
// Gap 1 — Workspace isolation. Every C-layer table carries workspaceId.
// Default "ws-main" means all existing rows belong to the worked-file workspace
// and existing queries continue to work without modification until they are
// made workspace-aware. ws-clean is the "as delivered" empty workspace.
// ---------------------------------------------------------------------------
model Workspace {
  id         String    @id @default(cuid())
  name       String
  label      String    @default("")
  kind       String    @default("fork") // clean | worked | fork
  forkedFrom String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String?

  @@index([kind])
}

// ---------------------------------------------------------------------------
// Layer C — Workpaper (ours). Grows in later blocks. Confidence is never a status.
// ---------------------------------------------------------------------------
model Verification {
  id               String   @id @default(cuid())
  workspaceId      String   @default("ws-main")
  extractedValueId String
  status           String // agreed_to_source | mismatch_with_source | not_printed | needs_human | human_verified | human_corrected
  method           String // auto | human
  verificationType String?
  sourceText       String?
  correctedValue   String?
  actorId          String?
  at               DateTime @default(now())
  note             String?
  version          Int      @default(0)

  @@index([workspaceId])
  @@index([extractedValueId])
}

model DocumentLink {
  id          String @id @default(cuid())
  workspaceId String @default("ws-main")
  fromDocId   String
  toDocId     String
  kind        String // duplicate_of | supersedes | same_issuer | related_prior_year
  basis       Json?
  method      String // auto | human
  actorId     String?

  @@index([workspaceId])
  @@index([fromDocId])
  @@index([toDocId])
}

model PageLink {
  id              String @id @default(cuid())
  workspaceId     String @default("ws-main")
  docId           String
  pageNo          Int
  duplicateOfPage Int
  basis           Json?

  @@index([workspaceId])
  @@index([docId])
}

model Disposition {
  id          String @id @default(cuid())
  workspaceId String @default("ws-main")
  documentId  String
  status      String // used | duplicate_not_counted | superseded | partial_extraction | structured_elsewhere | received_after_return | unaccounted
  reason      String?
  refs        String[]

  @@unique([workspaceId, documentId])
  @@index([workspaceId])
}

model CheckRun {
  id          String   @id @default(cuid())
  workspaceId String   @default("ws-main")
  versionId   String
  at          DateTime @default(now())
  codeVersion String?

  results CheckResult[]

  @@index([workspaceId])
}

model CheckResult {
  id           String  @id // stable finding id = sha256(checkId + sorted refs)
  workspaceId  String  @default("ws-main")
  runId        String
  checkId      String
  status       String // pass | fail | warn | info
  title        String
  expected     Json?
  actual       Json?
  delta        BigInt?
  taxEffectFed BigInt?
  taxEffectCa  BigInt?
  rateCategory String?
  refs         String[]
  explanation  String?
  suggestedFix Json?

  run CheckRun @relation(fields: [runId], references: [id])

  @@index([workspaceId])
  @@index([runId])
  @@index([checkId])
}

model Attachment {
  id          String   @id @default(cuid())
  workspaceId String   @default("ws-main")
  kind        String // file | message | note
  storageUri  String?
  sha256      String?
  text        String?
  uploadedBy  String?
  at          DateTime @default(now())

  links AttachmentLink[]

  @@index([workspaceId])
}

model AttachmentLink {
  id           String @id @default(cuid())
  workspaceId  String @default("ws-main")
  attachmentId String
  targetKind   String // document | extracted_value | line | check_result
  targetId     String

  attachment Attachment @relation(fields: [attachmentId], references: [id])

  @@index([workspaceId])
  @@index([targetKind, targetId])
}

// ---------------------------------------------------------------------------
// Block 2 — Change + Judgment
// ---------------------------------------------------------------------------
model Issue {
  id          String   @id // stable fingerprint
  workspaceId String   @default("ws-main")
  title       String
  area        String
  kind        String
  status      String   @default("open") // open | proposed | in_review | resolved | dismissed
  findingIds  String[]
  refs        String[]
  ownerId     String?
  materiality BigInt   @default(0)
  dismissReason String?
  version     Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([status])
}

model Adjustment {
  id            String   @id @default(cuid())
  workspaceId   String   @default("ws-main")
  issueId       String?
  baseVersionId String
  targets       Json // AdjTarget[]
  primaryLineKey String?
  rateCategory  String?
  caSourceFlag  Boolean  @default(false)
  baseDeltaCents BigInt  @default(0)
  taxEffectFed  BigInt   @default(0)
  taxEffectCa   BigInt   @default(0)
  paymentEffectFed BigInt @default(0)
  paymentEffectCa  BigInt @default(0)
  method        String // rate_estimate | what_if_exact
  reason        String
  evidenceIds   String[]
  preparedBy    String?
  reviewedBy    String?
  approvedBy    String?
  batchId       String?
  supersedesId  String?
  version       Int      @default(0)
  status        String   @default("draft")
  standardVersion Int? // firm-standards version this was evaluated under (7.1)
  createdAt     DateTime @default(now())
  approvedAt    DateTime?

  @@index([workspaceId])
  @@index([issueId])
  @@index([status])
}

model FactCorrection {
  id               String   @id @default(cuid())
  workspaceId      String   @default("ws-main")
  extractedValueId String
  original         Json // read-only copy
  corrected        Json
  verificationType String?
  reason           String
  evidenceIds      String[]
  actorId          String?
  at               DateTime @default(now())

  @@index([workspaceId])
  @@index([extractedValueId])
}

model Batch {
  id              String   @id @default(cuid())
  workspaceId     String   @default("ws-main")
  actorId         String?
  action          String
  itemRefs        String[]
  previewHash     String?
  appliedAt       DateTime @default(now())
  undoneByBatchId String?

  @@index([workspaceId])
}

model Snapshot {
  id          String   @id @default(cuid())
  workspaceId String   @default("ws-main")
  label       String
  kind        String // engine_version | review_point | client_signed | filed | manual
  eventSeq    Int
  asOf        DateTime
  contentHash String
  lines       Json
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

model Scenario {
  id             String   @id @default(cuid())
  workspaceId    String   @default("ws-main")
  ownerId        String?
  baseSnapshotId String?
  changes        Json
  result         Json
  promotedToIds  String[]
  createdAt      DateTime @default(now())

  @@index([workspaceId])
}

model UserCursor {
  userId      String @id
  workspaceId String @default("ws-main")
  lastSeenSeq Int    @default(0)

  @@index([workspaceId])
}

model Decision {
  id              String   @id @default(cuid())
  workspaceId     String   @default("ws-main")
  issueId         String?
  question        String
  facts           String?
  evidenceIds     String[]
  type            String
  options         Json
  selectedOptionId String?
  authority       String?
  positionStrength String?
  preparedBy      String?
  reviewedBy      String?
  approvedBy      String?
  status          String   @default("draft")
  revision        Int      @default(0)
  supersedesId    String?
  dependencyHash  String?
  watchedLineKeys String[]
  weakEvidenceAccepted Boolean @default(false)
  missingEvidenceResolved Boolean @default(false)
  standardVersion Int? // firm-standards version this was evaluated under (7.1)
  createdAt       DateTime @default(now())

  @@index([workspaceId])
  @@index([issueId])
}

model DueDiligence {
  id                String   @id @default(cuid())
  workspaceId       String   @default("ws-main")
  credit            String
  personId          String?
  items             Json
  status            String   @default("open")
  blockedByIssueIds String[]

  @@index([workspaceId])
}

model ExpectedDocument {
  id                String  @id @default(cuid())
  workspaceId       String  @default("ws-main")
  source            String
  description       String
  matchedDocumentId String?
  status            String  @default("expected")

  @@index([workspaceId])
}

model AreaReview {
  id                String   @id @default(cuid())
  workspaceId       String   @default("ws-main")
  area              String
  computedReadiness String
  attestedBy        String?
  attestedAt        DateTime?
  reason            String?

  @@unique([workspaceId, area])
  @@index([workspaceId])
}

model OutsideFiling {
  id               String    @id @default(cuid())
  workspaceId      String    @default("ws-main")
  filing           String
  whoFiles         String?
  inEngagement     Boolean   @default(false)
  status           String    @default("open")
  evidence         String[]
  clientNotifiedAt DateTime?

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Block 3 — People
// ---------------------------------------------------------------------------
model Question {
  id                 String    @id @default(cuid())
  workspaceId        String    @default("ws-main")
  fromId             String
  toId               String
  targetKind         String
  targetId           String
  text               String
  dueAt              DateTime?
  status             String    @default("open")
  blocksFiling       Boolean   @default(false)
  answerAttachmentId String?
  createdAt          DateTime  @default(now())

  @@index([workspaceId])
  @@index([targetKind, targetId])
}

model ReviewNote {
  id          String   @id @default(cuid())
  workspaceId String   @default("ws-main")
  authorId    String
  assigneeId  String?
  targetKind  String
  targetId    String
  severity    String
  status      String   @default("open")
  thread      Json     @default("[]")
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([targetKind, targetId])
  @@index([status])
}

model SignOff {
  id              String   @id @default(cuid())
  workspaceId     String   @default("ws-main")
  level           String
  scope           String
  coveredRefs     String[]
  coveredHash     String
  signedBy        String
  signedAt        DateTime @default(now())
  status          String   @default("valid")
  reopenReason    String?
  diff            String?
  standardVersion Int? // firm-standards version this was signed under (7.1)

  @@index([workspaceId])
  @@index([scope])
  @@index([status])
}

model Assignment {
  id          String    @id @default(cuid())
  workspaceId String    @default("ws-main")
  scopeKind   String
  scopeId     String
  staffId     String
  role        String
  dueAt       DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([staffId])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String    @default("ws-main")
  userId      String
  type        String
  entityId    String
  message     String
  readAt      DateTime?
  at          DateTime  @default(now())

  @@index([workspaceId])
  @@index([userId])
}

model TimeEntry {
  id          String   @id @default(cuid())
  workspaceId String   @default("ws-main")
  staffId     String
  area        String
  minutes     Int
  note        String?
  at          DateTime @default(now())

  @@index([workspaceId])
  @@index([area])
}

model ViewLog {
  id          String   @id @default(cuid())
  workspaceId String   @default("ws-main")
  actorId     String
  field       String
  entityId    String
  reason      String?
  at          DateTime @default(now())

  @@index([workspaceId])
  @@index([actorId])
}

model SoftLock {
  id          String   @id @default(cuid())
  workspaceId String   @default("ws-main")
  entityKind  String
  entityId    String
  holderId    String
  expiresAt   DateTime

  @@unique([workspaceId, entityKind, entityId])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Block 3 — Filing and after
// ---------------------------------------------------------------------------
model FilingStatus {
  id           String   @id @default(cuid())
  workspaceId  String   @default("ws-main")
  jurisdiction String // federal | california
  state        String   @default("in_preparation")
  updatedAt    DateTime @default(now())

  @@unique([workspaceId, jurisdiction])
  @@index([workspaceId])
}

model Submission {
  id           String   @id // the agency submission id (immutable once rejected/accepted)
  workspaceId  String   @default("ws-main")
  jurisdiction String
  snapshotHash String
  status       String // transmitted | rejected | accepted | not_transmitted
  errors       Json     @default("[]")
  at           DateTime

  @@index([workspaceId])
  @@index([jurisdiction])
}

model Extension {
  id                    String   @id @default(cuid())
  workspaceId           String   @default("ws-main")
  form                  String
  filedBy               String
  basisVersion          String
  estimatedBalanceCents BigInt
  paidCents             BigInt
  roundingRule          String
  note                  String
  filedAt               DateTime @default(now())

  @@index([workspaceId])
}

model AmendmentCase {
  id               String   @id @default(cuid())
  workspaceId      String   @default("ws-main")
  jurisdiction     String
  reason           String
  baseSnapshotId   String // the filed snapshot — never mutated
  baseSnapshotHash String
  openedBy         String
  status           String   @default("open")
  createdAt        DateTime @default(now())

  @@index([workspaceId])
}

model Notice {
  id               String    @id // N-2025-L566
  workspaceId      String    @default("ws-main")
  agency           String
  type             String
  taxYear          Int
  dated            DateTime
  responseDue      DateTime?
  status           String    @default("open")
  items            Json      @default("[]")
  legalHold        Boolean   @default(true)
  responsePackHash String?
  createdAt        DateTime  @default(now())

  @@index([workspaceId])
}

model ReplayConflict {
  id          String   @id @default(cuid())
  workspaceId String   @default("ws-main")
  eventId     String
  scripted    String
  finalState  String
  resolution  String
  note        String
  at          DateTime @default(now())

  @@index([workspaceId])
}

// Append-only. Every workpaper write emits one. Hash-chained PER WORKSPACE for
// tamper-evidence. seq is a global autoincrement (preserves global ordering);
// the hash chain is scoped: prevHash is the last event in the same workspace.
model Event {
  seq         Int      @id @default(autoincrement())
  id          String   @unique @default(cuid())
  workspaceId String   @default("ws-main")
  at          DateTime @default(now())
  actorId     String?
  type        String
  entityKind  String
  entityId    String
  payload     Json
  prevHash    String?
  hash        String

  @@index([workspaceId])
  @@index([workspaceId, entityKind, entityId])
}

// ---------------------------------------------------------------------------
// Block 4 — Firm (Feature 7)
// ---------------------------------------------------------------------------

// 7.1 Firm-wide standards, versioned. An admin edit creates a NEW row (version).
// Every Decision/Adjustment/SignOff records the version it was evaluated under
// (standardVersion columns below). Past approvals are never silently re-graded.
model FirmStandard {
  version   Int      @id @default(autoincrement())
  content   Json // normalized StandardContent (thresholds, levels, rules, steps, retention)
  createdBy String?
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 7.2 Sensitive fields, encrypted at rest with AES-256-GCM. Only reachable
// through revealSensitive(actor, ref, reason), which logs a ViewLog. Everything
// else stores the maskToken.
model SensitiveValue {
  id          String   @id @default(cuid())
  ref         String   @unique // stable address, e.g. "person:theo:ssn"
  kind        String // ssn | itin | ein | account | routing | ip_pin | pin_8879 | dob
  ciphertext  String // base64
  iv          String // base64
  authTag     String // base64
  maskToken   String // "•••-••-3390"
  ownerEntity String? // person/doc id this belongs to
  engagementId String?
  createdAt   DateTime @default(now())

  @@index([kind])
}

// 7.4 Staff lifecycle state (deactivation, clearance changes). Kept separate
// from the imported Staff row so import stays idempotent. Clearance changes are
// logged via the Event log.
model StaffState {
  staffId      String   @id
  active       Boolean  @default(true)
  clearance    Boolean  @default(false)
  deactivatedAt DateTime?
  note         String?
  updatedAt    DateTime @default(now())
}
